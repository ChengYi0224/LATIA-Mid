      "title": "販賣機按鍵",
      "room": "hall",
      "object": "vending",
      "requires": ["p3"],
      "stages": [
        {
          "id": "buttons",
          "type": "sequence",
          "prompt": "販賣機有 4 顆按鈕。",
          "buttons": [
            { "id": "coffee", "label": "咖啡" },
            { "id": "tea", "label": "紅茶" },
            { "id": "soy", "label": "豆漿" },
            { "id": "energy", "label": "能量飲" }
