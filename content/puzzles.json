{
  "puzzles": [
    {
      "id": "p1",
      "order": 1,
      "title": "筆電密碼鎖",
      "room": "r401",
      "object": "laptop",
      "requires": [],
      "stages": [
        {
          "id": "lock",
          "type": "code",
          "prompt": "筆電要輸入 4 位數密碼。",
          "answer": "5861",
          "maxWrong": 3,
          "wrongDeath": "d_p1_lockout",
          "wrongMessage": "密碼錯誤。",
          "successMessage": "解鎖了。"
        },
        {
          "id": "update",
          "type": "choice",
          "prompt": "Windows：更新已準備就緒。",
          "options": [
            { "id": "later", "label": "稍後提醒我", "outcome": "death", "death": "d_p1_later" },
            { "id": "now", "label": "立即重新啟動", "outcome": "death", "death": "d_p1_restart" },
            { "id": "schedule", "label": "排定時間（08:00 之後）", "outcome": "next", "message": "更新排到早上 8 點以後了。" }
          ]
        },
        {
          "id": "find",
          "type": "choice",
          "prompt": "雲端那份被刪了，報告還能去哪找？",
          "options": [
            { "id": "autorecover", "label": "開 Word，點最上面那個自動修復檔", "outcome": "death", "death": "d_p1_autorecover" },
            { "id": "history", "label": "看雲端的版本紀錄", "outcome": "next", "message": "紀錄寫著：最新那份最後在阿哲的筆電上編輯，23:40。阿哲的 IG 限動打卡在 503 研究室。" }
          ]
        }
      ],
      "reward": { "items": [], "flags": ["know_503"] }
    },
    {
      "id": "p2",
      "order": 2,
      "title": "講桌漢字滾輪鎖",
      "room": "r401",
      "object": "lectern",
      "requires": ["p1"],
      "stages": [
        {
          "id": "wheel",
          "type": "wheel",
          "prompt": "講桌抽屜有 4 個漢字滾輪。",
          "wheels": [
            ["準", "遲", "早", "補"],
            ["時", "交", "到", "考"],
            ["不", "必", "可", "要"],
            ["收", "扣", "改", "交"]
          ],
          "answer": ["遲", "交", "不", "收"],
          "wrongMessage": "抽屜沒動。",
          "successMessage": "抽屜打開了，裡面有一支鑰匙和一張公告。"
        },
        {
          "id": "drawer",
          "type": "choice",
          "prompt": "抽屜裡有一張公告：「期中報告延期一週。」右下角的小字：公告日期 去年 11/3。",
          "options": [
            { "id": "rest", "label": "太好了，坐下來休息一下", "outcome": "death", "death": "d_p2_lastyear" },
            { "id": "take", "label": "拿鑰匙就走", "outcome": "next", "message": "拿到後門鑰匙。" }
          ]
        }
      ],
      "reward": { "items": ["key_backdoor"], "flags": [] }
    },
    {
      "id": "p3",
      "order": 3,
      "title": "走廊電燈開關",
      "room": "hall",
      "object": "switch_panel",
      "requires": ["p2"],
      "stages": [
        {
          "id": "switches",
          "type": "toggles",
          "prompt": "01:00 以後走廊燈只剩一段亮著。面板上有 6 個開關，標籤都磨掉了。",
          "switches": ["1", "2", "3", "4", "5", "6"],
          "answer": ["2", "3", "5"],
          "wrongMessage": "去茶水間的那段路還是黑的。",
          "successMessage": "往茶水間的路亮了。"
        },
        {
          "id": "phone",
          "type": "choice",
          "prompt": "手機響了，是媽媽。",
          "options": [
            { "id": "answer", "label": "接起來", "outcome": "death", "death": "d_p3_mom" },
            { "id": "text", "label": "傳「晚點回妳」", "outcome": "next", "message": "媽媽回了一個讚。" }
          ]
        }
      ],
      "reward": { "items": [], "flags": ["hall_lit"] }
    },
    {
      "id": "p4",
