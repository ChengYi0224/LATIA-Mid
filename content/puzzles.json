      "stages": [
        {
          "id": "console",
          "type": "select",
          "prompt": "四樓的樓層廣播面板。監視器裡，警衛伯伯抱著鐵捲門遙控器睡在一樓警衛室。",
          "fields": [
            { "id": "channel", "label": "頻道", "options": [{ "id": "all", "label": "全館" }, { "id": "f1", "label": "一樓" }, { "id": "f5", "label": "五樓" }] },
            { "id": "sound", "label": "音效", "options": [{ "id": "bell", "label": "上課鐘" }, { "id": "breakfast", "label": "早餐店：大冰奶好了" }, { "id": "fire", "label": "消防演練" }] },
            { "id": "volume", "label": "音量", "options": [{ "id": "low", "label": "小" }, { "id": "mid", "label": "中" }, { "id": "max", "label": "最大" }] }
          ],
          "answer": { "channel": "f1", "sound": "breakfast", "volume": "low" },
          "deathRules": [
            { "match": { "channel": "all", "volume": "max" }, "death": "d_p8_wakeall" }
          ],
          "wrongMessage": "伯伯翻了個身，繼續睡。",
          "successMessage": "伯伯打開了鐵捲門。你衝下樓走出去，學長迎面走來：「欸學弟，吃個飯而已啦。」"
        },
        {
          "id": "senior",
          "type": "choice",
          "prompt": "學長就站在你面前：「欸學弟，吃個飯而已啦。」",
          "options": [
            { "id": "yes", "label": "好啊", "outcome": "death", "death": "d_p8_dinner" },
            { "id": "later", "label": "下次一定", "outcome": "next" }
          ]
        }
      ],
      "reward": { "items": [], "flags": ["escaped"] }
