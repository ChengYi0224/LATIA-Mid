          "wrongMessage": "嗶——錯誤。",
          "successMessage": "門開了。"
        },
        {
          "id": "router",
          "type": "choice",
          "prompt": "你走進系辦，路由器的燈全滅了。",
          "options": [
            { "id": "reboot", "label": "拔掉電源再插回去", "outcome": "next", "message": "網路回來了。鑰匙箱裡有一支寫著「廣播箱」的鑰匙。" }
          ]
        },
        {
          "id": "whiteboard",
          "type": "choice",
          "prompt": "白板寫著：「明天迎新物資誰能幫忙搬？」",
          "options": [
            { "id": "plusone", "label": "寫上 +1", "outcome": "death", "death": "d_p6_plusone" },
            { "id": "ignore", "label": "假裝沒看到", "outcome": "next", "message": "拿到廣播箱的鑰匙。" }
          ]
        }
      ],
      "reward": { "items": ["key_floor1"], "flags": ["network"] }
    },
    {
