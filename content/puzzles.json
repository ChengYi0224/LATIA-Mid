          "wrongMessage": "帳號或密碼錯誤。",
          "successMessage": "登入成功。你被丟回了首頁。"
        },
        {
          "id": "find_course",
          "type": "choice",
          "prompt": "首頁的「我的課程」：",
          "options": [
            { "id": "lastyear", "label": "軟體工程導論（去年）", "desc": "最近瀏覽", "outcome": "death", "death": "d_p7_lastyear" },
            { "id": "calendar", "label": "左側欄「行事曆」：期中報告截止 07:00", "outcome": "next", "message": "從行事曆點回今年的課程了。" },
            { "id": "thisyear", "label": "軟體工程導論（今年）", "outcome": "next", "message": "找到今年的課程了。" }
          ]
        },
        {
          "id": "final_submit",
          "type": "choice",
          "prompt": "組員傳來：「結論寫好了！在共用檔！」共用檔顯示：字數 4。",
          "options": [
            { "id": "merge", "label": "把共用檔的結論併進來再交", "outcome": "death", "death": "d_p7_conclusion" },
