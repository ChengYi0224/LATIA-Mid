          "answer": ["coffee", "coffee", "tea", "energy"],
          "wrongMessage": "販賣機沒反應。",
          "successMessage": "喀啦一聲，退幣口掉出一串鑰匙。"
        },
        {
          "id": "sofa",
          "type": "choice",
          "prompt": "鑰匙拿到了。旁邊的沙發看起來很好睡。",
          "options": [
            { "id": "nap", "label": "設 15 分鐘鬧鐘，瞇一下", "outcome": "death", "death": "d_p4_nap" },
            { "id": "go", "label": "拿了就走", "outcome": "next", "message": "拿到 503 的鑰匙。" }
          ]
        }
      ],
      "reward": { "items": ["key_503"], "flags": [] }
    },
    {
      "id": "p5",
      "order": 5,
      "title": "依序抽書",
      "room": "r503",
      "object": "bookshelf",
      "requires": ["p4"],
      "stages": [
        {
          "id": "books",
          "type": "sequence",
          "prompt": "阿哲的筆電沒電了。書架上有 6 本書。",
          "buttons": [
            { "id": "algo", "label": "演算法（第三版）" },
            { "id": "os", "label": "作業系統" },
            { "id": "db", "label": "資料庫系統" },
            { "id": "net", "label": "計算機網路" },
            { "id": "calc", "label": "微積分" },
            { "id": "stat", "label": "統計學" }
          ],
          "answer": ["algo", "os", "db", "net"],
          "wrongMessage": "書架沒動靜。",
          "successMessage": "書架後面掉出一條充電器。筆電開機了。"
        },
        {
          "id": "azhe",
          "type": "choice",
          "prompt": "阿哲迷迷糊糊醒來：「我幫你整理一下資料夾……」",
          "options": [
            { "id": "yes", "label": "好啊，謝謝", "outcome": "death", "death": "d_p5_tidy" },
            { "id": "no", "label": "不用啦，你繼續睡", "outcome": "next", "message": "阿哲又睡著了。" }
          ]
        },
        {
          "id": "file",
          "type": "choice",
          "prompt": "桌面上有三個檔案，要複製哪一個？",
          "options": [
            { "id": "final", "label": "最終版.docx", "desc": "修改時間 22:10", "outcome": "death", "death": "d_p5_final" },
            { "id": "really", "label": "最終版_真的最終.docx", "desc": "修改時間 21:55", "outcome": "death", "death": "d_p5_really" },
            { "id": "final1", "label": "最終版(1).docx", "desc": "修改時間 23:40", "outcome": "next", "message": "報告複製到隨身碟了。" }
          ]
        }
      ],
      "reward": { "items": ["usb_report"], "flags": [] }
    },
    {
      "id": "p6",
