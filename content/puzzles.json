            { "id": "forgot", "label": "忘記帳號或密碼嗎？", "outcome": "death", "death": "d_p7_forgot" },
            { "id": "contact", "label": "保持聯繫：寫信給管理者", "outcome": "death", "death": "d_p7_admin" },
            { "id": "autofill", "label": "直接按「登入」", "outcome": "death", "death": "d_p7_senior_account" },
            { "id": "clear", "label": "清掉欄位，自己輸入", "outcome": "next" }
